{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Tree",
  "version": "0.1.2",
  "identifier": "dev.knowledgetree.desktop",
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../../frontend"
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../../frontend"
    },
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knowledge Tree",
        "width": 1040,
        "height": 680,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
